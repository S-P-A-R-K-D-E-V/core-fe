# In production, API calls are proxied server-side via Next.js rewrites.
# BACKEND_URL is set as a runtime env var in k8s/deployment.yaml (NOT a build arg).
# So NEXT_PUBLIC_HOST_API must be empty — browser calls relative paths (/auth/..., /users/...).
NEXT_PUBLIC_HOST_API=
NEXT_PUBLIC_ASSETS_API=

# Sign in with Apple trên web (auth.devbyspark.com) — Services ID, không phải bí mật.
NEXT_PUBLIC_APPLE_SERVICES_ID=com.devbyspark.store.web
