# In production, API calls are proxied server-side via Next.js rewrites.
# BACKEND_URL is set as a runtime env var in k8s/deployment.yaml (NOT a build arg).
# So NEXT_PUBLIC_HOST_API must be empty — browser calls relative paths (/auth/..., /users/...).
NEXT_PUBLIC_HOST_API=
NEXT_PUBLIC_ASSETS_API=

# Sign in with Apple trên web (trang auth) — Services ID, không phải bí mật.
NEXT_PUBLIC_APPLE_SERVICES_ID=com.devbyspark.store.web

# Trang đăng nhập tập trung (src/auth/utils/saas-host.ts). Link mới trỏ về NEXT_PUBLIC_AUTH_HOST; tên miền
# trong ALIASES vẫn chạy đầy đủ. Chuyển sang auth.store.devbyspark.com: khai báo tên miền mới với Google
# (Authorized JavaScript origins) + Apple (Services ID: Domains, Return URL /sso/start/) rồi đổi chỗ 2 giá trị.
NEXT_PUBLIC_AUTH_HOST=auth.devbyspark.com
NEXT_PUBLIC_AUTH_HOST_ALIASES=auth.store.devbyspark.com
